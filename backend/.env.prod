APP_ENV=prod
APP_NAME="Smart IT Asset & Support Ticket Management System"
API_V1_PREFIX=/api/v1
DEBUG=false

SERVER_HOST=0.0.0.0
SERVER_PORT=8000

DB_TYPE=postgresql
DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DB_HOST=db
DB_PORT=5432
DB_NAME=it_asset_prod
DB_USER=prod_db_user
DB_PASSWORD=change_this_in_vault_or_env

SECRET_KEY=must_be_set_via_secure_environment_variable_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

LOG_LEVEL=WARNING
LOG_FILE=logs/app_prod.log

CORS_ORIGINS=https://portal.company.com,https://it-asset-management-system-malj.vercel.app
EXTERNAL_API_URL=https://worldtimeapi.org/api/timezone/Etc/UTC
