# Application Profile (dev | qa | prod)
APP_ENV=dev
APP_NAME="Smart IT Asset & Support Ticket Management System"
API_V1_PREFIX=/api/v1
DEBUG=true

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database Configuration
# For local development without Docker, SQLite can be used: sqlite:///./it_assets.db
# For PostgreSQL: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=it_asset_db
DB_USER=postgres
DB_PASSWORD=change_me
DATABASE_URL=sqlite:///./it_assets.db

# Security & JWT
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# External API Integration URL
EXTERNAL_API_URL=https://worldtimeapi.org/api/timezone/Etc/UTC
