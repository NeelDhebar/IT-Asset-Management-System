APP_ENV=qa
APP_NAME="Smart IT Asset & Support Ticket Management System (QA)"
API_V1_PREFIX=/api/v1
DEBUG=false

SERVER_HOST=0.0.0.0
SERVER_PORT=8000

DB_TYPE=postgresql
DATABASE_URL=postgresql+psycopg2://qa_user:qa_password@qa-db:5432/it_asset_qa
DB_HOST=qa-db
DB_PORT=5432
DB_NAME=it_asset_qa
DB_USER=qa_user
DB_PASSWORD=qa_password

SECRET_KEY=qa_secret_key_environment_configuration_only_32bytes_sample!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

LOG_LEVEL=INFO
LOG_FILE=logs/app_qa.log

CORS_ORIGINS=https://qa.internal.company.com
EXTERNAL_API_URL=https://worldtimeapi.org/api/timezone/Etc/UTC
